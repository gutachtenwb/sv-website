+      <span className="mt-3 inline-flex items-center gap-1.5 text-sm font-medium text-safran-dunkel">
+        Mehr erfahren
+        <span aria-hidden="true" className="transition-transform group-hover:translate-x-1">
+          →
+        </span>
+      </span>
+    </Link>
+  );
+}
